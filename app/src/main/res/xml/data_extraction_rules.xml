<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup. An include list backs up only what is named, so Firebase auth/cache files
     and the device-specific location_permission prefs stay out: restored devices start signed out
     and re-link synced routes by remoteId on the next sign-in. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="rygg.db" />
        <include domain="database" path="rygg.db-wal" />
        <include domain="database" path="rygg.db-shm" />
        <include domain="file" path="trips/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="app_locale.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="rygg.db" />
        <include domain="database" path="rygg.db-wal" />
        <include domain="database" path="rygg.db-shm" />
        <include domain="file" path="trips/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="app_locale.xml" />
    </device-transfer>
</data-extraction-rules>
