<?xml version="1.0" encoding="utf-8"?>
<!-- Filled rather than stroked: a 4-unit outline loses most of its mass once the adaptive icon is
     scaled to a home screen, and read as a thin scratch on a light wallpaper. Scaled to sit inside
     the 66/108 safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <group
        android:scaleX="0.70"
        android:scaleY="0.70"
        android:translateX="7.2"
        android:translateY="5.1">
        <path android:pathData="M6,38 L18,16l8,12 6,-8 10,18z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="6"
                    android:startY="38"
                    android:endX="42"
                    android:endY="16"
                    android:type="linear">
                    <item android:offset="0" android:color="#FF16A06B" />
                    <item android:offset="1" android:color="#FF3FD89A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
