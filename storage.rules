rules_version = '2';

// Route .gpx blobs. Private copies live under users/{uid}/; public share copies live under
// shared/. The 20 MB ceiling mirrors MAX_FILE_BYTES in RouteSyncManager / the file workers.
service firebase.storage {
  match /b/{bucket}/o {

    // A signed-in account's private route files. Delete is its own rule: on a delete
    // request.resource is null, so the size check would otherwise reject it.
    match /users/{uid}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 20 * 1024 * 1024;
    }

    // Public share copies: world-readable. An authed user may only CREATE a new object
    // (resource == null) — existing share blobs are immutable, so nobody can overwrite or tamper
    // with a route someone else already shared. The blob carries no owner, so delete is checked
    // against its sharedRoutes/{token} snapshot (shared/<token>.gpx); account deletion removes the
    // blob before the snapshot for this lookup to succeed.
    match /shared/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024;
      allow update: if false;
      allow delete: if request.auth != null
                    && firestore.get(
                         /databases/(default)/documents/sharedRoutes/$(fileName.split('[.]')[0])
                       ).data.ownerUid == request.auth.uid;
    }
  }
}
