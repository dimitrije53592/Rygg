rules_version = '2';

// Rygg route sync. A user's library lives under users/{uid}/routes and is private to that
// account. Shared-route snapshots live under sharedRoutes/{token} and are world-readable so a
// link recipient on any device (or signed out) can resolve them.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in account's private route metadata.
    match /users/{uid}/routes/{routeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public share snapshots. Anyone holding the unguessable token may read; only the authed
    // owner may create one, and it must be stamped with their own uid. No updates/deletes from
    // clients (a stale snapshot simply 404s at the Storage layer once its blob is gone).
    match /sharedRoutes/{token} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
