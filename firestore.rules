rules_version = '2';

// Rygg route sync. A user's library lives under users/{uid}/routes and is private to that
// account. Shared-route snapshots live under sharedRoutes/{token} and are world-readable so a
// link recipient on any device (or signed out) can resolve them.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in account's private route metadata.
    match /users/{uid}/routes/{routeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public share snapshots. Anyone holding the unguessable token may read; only the authed
    // owner may create one, and it must be stamped with their own uid. No updates/deletes from
    // clients (a stale snapshot simply 404s at the Storage layer once its blob is gone).
    match /sharedRoutes/{token} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Write-only feedback drop box. Guests reach it with an anonymous session, so any authed uid
    // may file a report stamped with its own uid, but nothing can be read back or amended from a
    // client. Triage happens in the Firebase console, which bypasses these rules. Pinning
    // createdAt to request.time forces a server timestamp the client cannot forge; rules cannot
    // rate-limit without a read, so the app throttles sends locally as well.
    match /feedback/{feedbackId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.category in ['BUG', 'IDEA', 'OTHER']
                    && request.resource.data.createdAt == request.time;
    }
  }
}
